KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=ecommerce-transactions
CSV_FILE_PATH=data/raw/online_retail.csv
STREAM_DELAY_SECONDS=0.1
MAX_MESSAGES=0
CLIENT_ID=ecommerce-producer

SPARK_APP_NAME=EcommerceStreaming
SPARK_MASTER=local[*]
KAFKA_STARTING_OFFSETS=earliest
TRIGGER_INTERVAL_SECONDS=10
WATERMARK_SECONDS=1
TUMBLING_WINDOW_SECONDS=60
SLIDING_WINDOW_SECONDS=300
SLIDING_SLIDE_SECONDS=60
CHECKPOINT_DIR=data/checkpoint
PROCESSED_DIR=data/processed

CLEANED_PARQUET_PATH=data/processed/cleaned
MODEL_OUTPUT_DIR=models/revenue_model
TEST_SPLIT_RATIO=0.2
RANDOM_SEED=42

SQLITE_DB_PATH=data/ecommerce.db
SQLITE_POOL_SIZE=5
SQLITE_TIMEOUT_SECONDS=30.0
